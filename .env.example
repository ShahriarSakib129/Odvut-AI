# =============================================================================
#  INFO GROUP AI BOT - environment configuration
# -----------------------------------------------------------------------------
#  1. Copy this file:            cp .env.example .env
#  2. Fill in the values below.
#  3. NEVER commit the real .env file (it is already in .gitignore).
#
#  On Render: add the same keys under
#  Dashboard -> your service -> Environment -> Add Environment Variable.
# =============================================================================

# ---------------------------------------------------------------------------
# 1) REQUIRED - Telegram
# ---------------------------------------------------------------------------
# Get it from @BotFather -> /newbot  (format: 123456789:ABCdef...)
BOT_TOKEN=

# Your own Telegram user id (the admin who may use /stats, /clear_memory, ...).
# Send /whoami to the bot to learn your id.
ADMIN_ID=
# Optional: extra admin ids (comma separated) - same effect as ADMIN_ID
ADMIN_IDS=

# The admin whose messages become the bot's memory (usually the same person).
# Can be a comma separated list: 111111111,222222222
TARGET_ADMIN_ID=
# Optional alternative to TARGET_ADMIN_ID (resolved at runtime from the group)
TARGET_ADMIN_USERNAME=

# The Telegram group id (negative number, e.g. -1001234567890).
# Send /whoami in the group to read it. Leave empty to accept any group.
GROUP_ID=

# ---------------------------------------------------------------------------
# 2) REQUIRED - Groq AI
# ---------------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# Any Groq chat model id. Change it here without touching the code.
# Examples: openai/gpt-oss-120b | openai/gpt-oss-20b | llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI-compatible endpoints (change only if you proxy Groq yourself)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODELS_URL=https://api.groq.com/openai/v1/models

# ---------------------------------------------------------------------------
# 3) REQUIRED - Supabase PostgreSQL
# ---------------------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the "Connection pooling / Session" URI on the free tier, e.g.
# postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# 4) REQUIRED in production - webhook
# ---------------------------------------------------------------------------
# Your Render URL (no trailing slash). Leave empty for local long polling.
PUBLIC_URL=

# Random secret; protects /webhook. Generate one:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Register the Telegram webhook automatically on startup
SET_WEBHOOK_ON_STARTUP=true
WEBHOOK_PATH=/webhook
WEBHOOK_REQUIRE_SECRET=true
DROP_PENDING_UPDATES=true
WEBHOOK_MAX_CONNECTIONS=20

# ---------------------------------------------------------------------------
# 5) Behaviour
# ---------------------------------------------------------------------------
# Answer when a member mentions the bot / replies to it / uses a trigger word
TRIGGER_ON_MENTION=true
TRIGGER_ON_REPLY=true
TRIGGER_ON_COMMAND=true
# Comma separated extra trigger words, e.g. askai,aihelp
TRIGGER_KEYWORDS=
# Members may also ask the bot in a private chat
ANSWER_IN_PRIVATE_CHAT=true
# Max AI answers per member per minute
RATE_LIMIT_PER_MINUTE=6
MAX_QUESTION_CHARS=1200
MAX_ANSWER_CHARS=4000
TYPING_INDICATOR=true
# Footer appended to AI answers inside the group
AI_DISCLOSURE_IN_GROUP=true
AI_DISCLOSURE_TEXT=🤖 AI উত্তর (Admin-এর শেয়ার করা তথ্য ও স্টাইল অনুসারে)

# ---------------------------------------------------------------------------
# 6) Memory collection / Q&A pairing
# ---------------------------------------------------------------------------
# How long after a member question an admin message may still be paired with it
QA_PAIR_WINDOW_SECONDS=300
# true  -> only messages detected as questions are paired
QA_PAIR_REQUIRE_QUESTION=false
# true  -> also pair a single very recent question with no keyword overlap
#          (risk of false pairs; keep false unless you see missing pairs)
QA_PAIR_LONE_QUESTION=false
# How long an unanswered question stays "open"
PENDING_QUESTION_TTL_SECONDS=1800
# Keep a lightweight analytics log of member messages (never AI memory)
LOG_UNANSWERED_QUESTIONS=true
LOG_TEXT_CHARS=600
# Log every member message (not only questions) - increases storage usage
TRACK_ALL_MEMBER_MESSAGES=false

# ---------------------------------------------------------------------------
# 7) Retrieval / context limits (cost control)
# ---------------------------------------------------------------------------
MAX_MEMORY_RESULTS=10
MAX_QA_RESULTS=5
MAX_CONTEXT_CHARS=12000
MEMORY_CANDIDATE_LIMIT=200
MIN_RELEVANCE_SCORE=0.06
RECENCY_HALF_LIFE_DAYS=45
QA_PRIORITY_BOOST=1.25
DEDUPE_THRESHOLD=0.86
INCLUDE_RECENT_FALLBACK=8
# Local (free) semantic embeddings - no vector database needed
EMBEDDING_ENABLED=true

# ---------------------------------------------------------------------------
# 8) AI tuning / reliability
# ---------------------------------------------------------------------------
GROQ_ENABLED=true
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.35
GROQ_TOP_P=0.95
GROQ_MAX_TOKENS=800
# Answer even when no admin memory matched (general knowledge, clearly labelled)
AI_ANSWER_WITHOUT_MEMORY=true

# ---------------------------------------------------------------------------
# 9) Cache (cost optimisation)
# ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# 10) Database tuning
# ---------------------------------------------------------------------------
DB_POOL_MAX=4
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
# true -> run database/schema.sql automatically when tables are missing
DB_AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# 11) Logging / misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_REQUESTS=true
ENVIRONMENT=production
# Start the Telegram application in the background as soon as the app boots.
# Set to false for tests / offline tooling (the bot then never connects).
AUTOSTART_BOT=true
# How often housekeeping (expire questions, purge logs/cache) runs
MAINTENANCE_INTERVAL_SECONDS=21600
